# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Primary vision model and a fallback if the primary is rate-limited or unavailable.
# Check current free-tier models/limits in AI Studio.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# live = call Gemini (falls back to cached responses on failure)
# mock = never call Gemini; return deterministic fake estimates (offline dev)
NOURISH_MODE=live
